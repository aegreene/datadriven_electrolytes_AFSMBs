integrator              = steep
emtol                   = 1e-4
emstep			= 0.01
nsteps                  = 1000000
nstlist                 = 10
cutoff-scheme           = Verlet
rlist                   = 1.3
vdwtype                 = Cut-off
;vdw-modifier            = Potential-switch
;rvdw_switch             = 1.0
rvdw                    = 1.3
coulombtype             = PME
;coulombtype		= cutoff
rcoulomb                = 1.3
;
constraints             = h-bonds
constraint_algorithm    = LINCS
