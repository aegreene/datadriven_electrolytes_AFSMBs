integrator              = md
dt                      = 0.002 ; 2 fs
nsteps                  = 5000 ; 10 ps
nstxtcout               = 25000
nstvout                 = 0
nstfout                 = 0
nstcalcenergy           = 100
nstenergy               = 1000
nstlog                  = 1000
;
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.3
vdwtype                 = Cut-off
;vdw-modifier            = Potential-switch
;rvdw_switch             = 1.0
rvdw                    = 1.3
coulombtype             = PME
rcoulomb                = 1.3
DispCorr		= EnerPres ; added for OPC3
;
tcoupl                  = V-rescale
tc_grps                 = System
tau_t                   = 1.0
ref_t                   = 298.15
;
constraints             = h-bonds
constraint_algorithm    = LINCS
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = System
;
gen-vel                 = yes
gen-temp                = 298.15
gen-seed                = -1
